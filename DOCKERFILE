# ╔══════════════════════════════════════════════════════════════╗
# ║  ChishiMeow — 千島神社的小精靈                               ║
# ║  輕量 image：程式碼由 start.sh 在啟動時從 GitHub clone       ║
# ╚══════════════════════════════════════════════════════════════╝

FROM python:3.12-slim

# ── 系統依賴（Playwright Chromium + git）────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpangocairo-1.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    libxshmfence1 \
    libglib2.0-0 \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# ── 工作目錄（程式碼會由 start.sh clone 進來）───────────────────
WORKDIR /home/container

# ── 複製啟動腳本 ────────────────────────────────────────────────
COPY start.sh /start.sh
RUN chmod +x /start.sh

# ── 資料 volume（DB、cookies、playwright browsers）──────────────
VOLUME /data

# ── 預設環境變數（可被 docker run -e 或 .env 覆蓋）─────────────
ENV PYTHONUNBUFFERED=1 \
    DATA_DIR=/data \
    GIT_ADDRESS=https://github.com/Chococar-SITE/ChishiMeow.git \
    BRANCH=main \
    AUTO_UPDATE=1 \
    USER_UPLOAD=0 \
    REQUIREMENTS_FILE=requirements.txt \
    PY_FILE=bot.py \
    INSTALL_PLAYWRIGHT=1

ENTRYPOINT ["/start.sh"]